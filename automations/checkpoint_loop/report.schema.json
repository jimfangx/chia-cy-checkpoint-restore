{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["milestone", "status", "summary", "evidence", "artifacts", "verification_commands"],
  "properties": {
    "milestone": {"type": "string"},
    "status": {"type": "string", "enum": ["in_progress", "ready", "blocked"]},
    "summary": {"type": "string"},
    "evidence": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "cwd", "argv"],
        "properties": {
          "purpose": {"type": "string"},
          "cwd": {"type": "string"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
